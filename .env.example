# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Telegram booking bot (server-only)
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_hex_or_safe_token
TELEGRAM_CHAT_ID=replace_after_starting_the_bot
TELEGRAM_ADMIN_USER_ID=replace_after_starting_the_bot

# Cloudflare Turnstile (optional until configured)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron protection for retention cleanup (server-only)
CRON_SECRET=replace_with_a_long_random_secret
