# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Telegram booking bot (server-only)
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_WEBHOOK_SECRET=replace_with_random_hex_or_safe_token

# Receives new booking messages + reference albums.
# Later this should point to Eva's private Telegram chat.
TELEGRAM_CHAT_ID=replace_after_starting_the_bot

# Comma/space-separated allowlist for the Booking admin Web App.
# Keep both the site owner and Eva here once her account is connected.
TELEGRAM_ADMIN_USER_IDS=111111111,222222222

# Legacy fallback only. If TELEGRAM_ADMIN_USER_IDS is set, this value is ignored.
TELEGRAM_ADMIN_USER_ID=

# Reserved for future reminder messages. If omitted, reminder code may fall back
# to TELEGRAM_CHAT_ID; set it to Eva's chat when reminders are enabled.
TELEGRAM_REMINDER_CHAT_ID=

# Cloudflare Turnstile (optional until configured)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron protection for retention cleanup (server-only)
CRON_SECRET=replace_with_a_long_random_secret
